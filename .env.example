# ── Local development (SQLite) ─────────────────────────────────────────────────
DATABASE_URL=sqlite:////app/data/portfolio.db
SECRET_KEY=change-me-to-something-long-and-random
ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Production (PostgreSQL via RDS) ───────────────────────────────────────────
# DATABASE_URL=postgresql://portfolio:<password>@<rds-endpoint>:5432/portfolio
# SECRET_KEY=<generate with: openssl rand -base64 32>
# ENVIRONMENT=production
# ALLOWED_ORIGINS=https://yourdomain.com

# ── Frontend (.env.local — never commit) ──────────────────────────────────────
# VITE_ADMIN_KEY=<same value as SECRET_KEY above>
